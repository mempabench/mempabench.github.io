 "metrics": {
  "PSA": {
   "name": "Preference Selection Accuracy",
   "unit": "%",
   "min": 0,
   "max": 100,
   "decimals": 1,
   "definition": "The fraction of the final probes in which the PA correctly selects the user's target setting."
  },
  "CS": {
   "name": "Context Sensitivity",
   "unit": "%",
   "min": 0,
   "max": 100,
   "decimals": 1,
   "definition": "Over the user–attribute pairs whose settings differ between work and personal contexts, a pair counts only when both selections are correct."
  },
  "PET": {
   "name": "Preference Evolution Tracking",
   "unit": "%",
   "min": 0,
   "max": 100,
   "decimals": 1,
   "definition": "Over the changing cells, a cell counts only when the selections before and after its change are both correct."
  },
  "BRS": {
   "name": "Behavioral Realization Score",
   "unit": "1–5",
   "min": 1,
   "max": 5,
   "decimals": 2,
   "definition": "An LLM judge reads the PA's public reply and the actions that actually ran, and scores from 1 to 5 how well the delivered interaction follows the target setting."
  },
  "PRS": {
   "name": "Perceived Realization Score",
   "unit": "1–5",
   "min": 1,
   "max": 5,
   "decimals": 2,
   "definition": "After each final probe, the user simulator re-reads the probe and rates from 1 to 5 how well the PA met its preference on the probed attribute."
  }
 },
